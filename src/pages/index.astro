---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Blog Diary Bray</title>
		<style>
			body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
			h1 { color: #333; }
			ul { list-style: none; padding: 0; }
			li { margin-bottom: 1.5rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
			a { text-decoration: none; color: #0070f3; }
			a:hover { text-decoration: underline; }
			.date { font-size: 0.9rem; color: #666; }
		</style>
	</head>
	<body>
		<h1>📖 Diary Coding Blog</h1>
		<p>Kumpulan artikel yang ditarik dari branch diary. Sat-set bray!</p>
		<hr />
		<ul>
			{posts.map((post) => (
				<li>
					<div class="date">{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
					<h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</li>
			))}
		</ul>
	</body>
</html>

---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
console.log('Post Body:', post.body);
const { Content } = await render(post);
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{post.data.title}</title>
		<style>
			body { font-family: sans-serif; max-width: 800px; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; }
			article { margin-top: 2rem; }
			.date { color: #666; font-size: 0.9rem; }
			a { color: #0070f3; text-decoration: none; }
		</style>
	</head>
	<body>
		<a href="/">← Kembali ke Beranda</a>
		<article>
			<header>
				<div class="date">{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
				<h1>{post.data.title}</h1>
				<hr />
			</header>
			<Content />
		</article>
	</body>
</html>
